# ============================================================================
# DataPilotAgent 环境变量模板
# 用法：复制为仓库根目录 .env 后按需修改 —— cp .env.example .env
# 说明：下方基础设施默认值与 docker-compose.infra.yml（本地编排）对齐，
#       本地起步无需改动即可连通；使用远程实例时替换对应连接信息。
# 安全：.env 已被 .gitignore 忽略，严禁将真实密钥提交到仓库。
# ============================================================================

# ---- PostgreSQL（业务数据 + 任务队列）----
# 也可用 DATABASE_URL 整体覆盖：postgresql+asyncpg://user:pass@host:5432/datapilot
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=datapilot
PG_USER=datapilot
PG_PASSWORD=datapilot

# ---- Redis ----
# 也可用 REDIS_URL 整体覆盖：redis://:password@host:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- MinIO（附件对象存储）----
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=datapilot
MINIO_SECRET_KEY=datapilot-minio
MINIO_BUCKET=datapilot

# ---- 应用安全 ----
# JWT 签名密钥：生产必须替换为强随机值（openssl rand -hex 32）
SECRET_KEY=change-me-in-prod
# Fernet 加密密钥（数据源密码 / API Key 等敏感字段，存为 enc: 前缀密文）
# 留空时开发模式自动生成并持久化到 data/ 下；生产必须显式提供：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# 是否启用登录认证（仅限本地调试关闭）
ENABLE_AUTH=true

# ---- 应用运行 ----
# 运行期数据目录（自动生成的加密密钥、附件临时库等，已被 gitignore）
APP_DATA_DIR=./data
# 表结构由 Alembic 管理：首次启动前先执行 `cd backend && ./venv/bin/alembic upgrade head`
# （后端已含初始迁移 alembic/versions/*_initial_schema.py）。
# 生产/正式环境固定 false；仅本地临时体验可改为 true 走开发期自动建表
AUTO_CREATE_TABLES=false
# CORS 白名单（JSON 数组格式）；生产替换为前端实际域名，禁止使用 *
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost:8080","http://localhost:80"]
